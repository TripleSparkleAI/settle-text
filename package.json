{
  "name": "settle-text",
  "version": "0.6.0",
  "private": true,
  "description": "Render text, images and vectors as a live settle of lights, in React. No theory needed: give it words and a font.",
  "license": "MIT",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./react": "./react/index.js",
    "./fonts.css": "./fonts/fonts.css"
  },
  "files": ["src", "react", "fonts", "docs", "examples", "README.md", "CHANGELOG.md", "PUBLISHING.md"],
  "sideEffects": ["*.css"],
  "keywords": ["react", "text", "font", "fonts", "canvas", "dot-matrix", "neon", "settle", "p-bits"],
  "engines": { "node": ">=18" },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "demo": "bash examples/demo/run.sh",
    "perf": "python3 tools/perf_check.py"
  },
  "dependencies": {
    "settle-see": "github:TripleSparkleAI/settle-see"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
